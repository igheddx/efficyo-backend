# Copy to .env and adjust, or export in your shell.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE

# Tipwave demo: tenant/cloud row UUIDs in app.services.tenant_service; IAM in app.core.demo_aws (account 393795841779).
DATABASE_URL=postgresql+psycopg2://optimizer:optimizer@127.0.0.1:5433/optimizer_db
FPTNEXT_AWS_SCAN_ALL_REGIONS=1
# Local dev: if your IAM user cannot sts:AssumeRole the Tipwave FptNextReadOnlyRole, set to 1 to use your default
# AWS CLI profile / env credentials instead (same permissions as that user; no role assumption).
# FPTNEXT_BYPASS_ASSUME_ROLE_FOR_TIPWAVE=1

# Inventory: scan every commercial region from ec2:DescribeRegions (not only the cloud account default).
# Turn on for real accounts like Tipwave so EC2/RDS/Lambda/EBS outside us-east-1 are included in findings.
# FPTNEXT_AWS_SCAN_ALL_REGIONS=1

# Wipe snapshots/findings/recommendations/outcomes/sync history for one cloud account (then run Sync):
# POST /api/v1/tenants/{tenant_id}/cloud-accounts/{cloud_account_id}/ingestion-data/reset
# Header: X-Role: root_admin (matches UI advanced session role).
# CLI: `python3 scripts/clear_cloud_account_ingestion.py --help` (repo root) loads backend/.env automatically.
# In zsh, do not put `# comments` on the same line as `export VAR=...` — put the comment on its own line.

# OIDC / Entra / Okta (all four required to enable GET /api/v1/auth/oidc/login):
# FPTNEXT_OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# FPTNEXT_OIDC_CLIENT_ID=
# FPTNEXT_OIDC_CLIENT_SECRET=
# With Vite dev proxy, prefer same host as the UI so the session cookie is stored for localhost:
# FPTNEXT_OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback
# Or call the API directly:
# FPTNEXT_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
# Optional: where to send the browser after login (Vite default below).
# FPTNEXT_OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/
# FPTNEXT_OIDC_SCOPES=openid email profile
